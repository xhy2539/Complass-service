# Runtime environment name, for example local/dev/test/prod.
APP_ENV=local

# Reserved database URL. The current scaffold does not connect to a database yet.
DATABASE_URL=sqlite:///./complass.db

# Reserved Coze workflow settings. They will be used when AI analysis is added.
COZE_API_BASE_URL=https://api.coze.cn
COZE_API_TOKEN=
COZE_WORKFLOW_ID=
COZE_MOCK_ENABLED=true

# Reserved upload limit for future contract file endpoints.
MAX_UPLOAD_SIZE_MB=20
