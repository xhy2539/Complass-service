# Runtime environment name, for example local/dev/test/prod.
APP_ENV=local

# Database connection
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/complass?charset=utf8mb4

# Coze workflow settings
COZE_API_BASE_URL=https://api.coze.cn
COZE_API_TOKEN=
COZE_WORKFLOW_ID=
COZE_MOCK_ENABLED=true

# Upload limit
MAX_UPLOAD_SIZE_MB=20

# JWT Configuration
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
