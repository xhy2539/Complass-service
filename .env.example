# Runtime environment name, for example local/dev/test/prod.
APP_ENV=prod
APP_PORT=8080
IMAGE=complass-service:latest

# MySQL container settings
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change_root_password
MYSQL_DATABASE=complass
MYSQL_USER=complass_user
MYSQL_PASSWORD=change_user_password

# Database connection (use docker service name "mysql")
DATABASE_URL=mysql+pymysql://complass_user:change_user_password@mysql:3306/complass?charset=utf8mb4

# Coze workflow settings
COZE_API_BASE_URL=https://api.coze.cn
COZE_ACCESS_TOKEN=change_this
COZE_API_TOKEN=
COZE_WORKFLOW_ID=
COZE_COMPARISON_WORKFLOW_ID=7634842444869861416
COZE_REVIEW_WORKFLOW_ID=7636289402251198473
COZE_WORKFLOW_TIMEOUT_SECONDS=120
COZE_UPLOAD_TIMEOUT_SECONDS=120

# Upload limit
MAX_UPLOAD_SIZE_MB=20

# JWT Configuration
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Redis (IM 会话缓存)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# 飞书 IM 机器人（飞书开放平台 → 应用 → 凭证与基础信息）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
