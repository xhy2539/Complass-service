pipeline {
    agent any

    parameters {
        // Fallback when Jenkins credential scope is restricted: input deploy key at build time.
        text(
            name: 'DEPLOY_SSH_KEY',
            defaultValue: '',
            description: 'OpenSSH private key content for root@deploy host'
        )
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        DEPLOY_HOST = '82.156.132.43'
        DEPLOY_USER = 'root'
        DEPLOY_DIR = '/opt/complass-service'
    }

    stages {
        stage('Deploy To Server') {
            steps {
                sh '''
                    set -eu
                    test -n "${DEPLOY_SSH_KEY}"

                    KEY_FILE="$(mktemp)"
                    trap 'rm -f "${KEY_FILE}"' EXIT
                    printf '%s\n' "${DEPLOY_SSH_KEY}" > "${KEY_FILE}"
                    chmod 600 "${KEY_FILE}"

                    set -x
                    ssh -i "${KEY_FILE}" -o StrictHostKeyChecking=no "${DEPLOY_USER}@${DEPLOY_HOST}" "
                        set -eux
                        cd ${DEPLOY_DIR}
                        git pull --ff-only
                        docker build -t complass-service:latest .
                        docker compose up -d
                        docker compose ps
                        curl -f http://127.0.0.1:8080/health
                    "
                '''
            }
        }
    }

    post {
        success {
            echo 'Deploy success'
        }
        failure {
            echo 'Deploy failed'
        }
    }
}
